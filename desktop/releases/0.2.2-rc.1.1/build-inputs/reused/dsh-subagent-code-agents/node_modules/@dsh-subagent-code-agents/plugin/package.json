{
  "name": "@dsh-subagent-code-agents/plugin",
  "version": "0.2.4",
  "description": "Multi-channel coding-agent subagent plugin internals (Codex / Claude Code / Grok Build / ACP)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tool": {
      "types": "./lib/tool.d.ts",
      "default": "./lib/tool.js"
    },
    "./auto-tool": {
      "types": "./lib/auto-tool.d.ts",
      "default": "./lib/auto-tool.js"
    },
    "./skill": {
      "types": "./lib/skill.d.ts",
      "default": "./lib/skill.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/tool.js",
    "lib/tool.d.ts",
    "lib/auto-tool.js",
    "lib/auto-tool.d.ts",
    "lib/roles.js",
    "lib/roles.d.ts",
    "lib/owned-runs.js",
    "lib/owned-runs.d.ts",
    "lib/run-notifier.js",
    "lib/run-notifier.d.ts",
    "lib/skill.js",
    "lib/skill.d.ts",
    "skills/dsh-code-agents/SKILL.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none"
  },
  "dependencies": {
    "@dsh-subagent-code-agents/core": "0.1.5",
    "@dsh-subagent-code-agents/channel-codex": "0.1.9",
    "@dsh-subagent-code-agents/channel-claude-code": "0.1.6",
    "@dsh-subagent-code-agents/channel-grok-build": "0.1.6",
    "@dsh-subagent-code-agents/channel-acp": "0.1.6",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-jobs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-permission-presets": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "subagent",
    "codex",
    "claude-code",
    "grok-build",
    "agent-client-protocol"
  ],
  "engines": {
    "node": ">=24"
  }
}
