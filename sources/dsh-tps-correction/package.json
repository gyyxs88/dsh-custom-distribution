{
  "name": "dsh-tps-correction",
  "version": "0.1.0-rc.2.2",
  "private": true,
  "type": "module",
  "description": "Pinned rc.2 receive TPS estimate, full trajectory compatibility module and original stats seat",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./metric": "./lib/metric.js",
    "./rc2": "./lib/rc2.js",
    "./stream-estimate": "./lib/stream-estimate.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "compat", "upstream", "upstream-manifest.json", "compat-build.json", "cordis.patch.yml", "LICENSE.deepseek", "README.md", "integration-contract.json"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "inject": [
    "@deepseek-ai/dsh-client-ui-chat", "@deepseek-ai/dsh-client-ui-trajectory", "@deepseek-ai/dsh-client-ui-primitives",
    "@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-locale"
  ] } },
  "peerDependencies": { "@deepseek-ai/cordis": "4.0.4", "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-trajectory": "0.2.0-rc.2", "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2", "zod": "4.6.5" },
  "engines": { "node": ">=22" },
  "scripts": { "test": "node --test test/*.test.mjs" }
}
